#!/bin/sh
# Generated by CMake. Source this before running a binary from this
# workspace by hand: the engine resolves its LLVM runtime bitcode through
# TI_LIB_DIR and aborts without it.
#
#   . ./build/engine-env.sh
#
# Engine checkout : @ENGINE_TAICHI_ROOT@ (@ENGINE_TAICHI_REVISION@)
# Engine build    : @ENGINE_TAICHI_BUILD@
#
# Nothing else is exported. The engine reads its own startup settings from
# the environment; set them here or in a caller if and when you want them.
export TI_LIB_DIR="@ENGINE_TAICHI_RUNTIME_DIR@"
