--- /dev/null
+++ b/field/test_unit_mass.py
@@ -0,0 +1,45 @@
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import numpy as np
+import pytest
+from field_engine_load_v0 import mass_of, attach_configuration
+from field_engine import Pool, Oracle, make_kernel
+
+
+def test_all_bytes_have_equal_mass():
+    assert {mass_of([b]) for b in range(256)} == {2}
+    assert mass_of([0, 255, 17]) == 6
+
+
+def test_configuration_preserves_order_and_counts_units():
+    particles = [{'identity': ('codepoint', 65), 'raw': [65]}]
+    attach_configuration(particles, 'endpoint')
+    assert particles[0]['config'] == [0, 0, 4, 1]
+    assert particles[0]['mass'] == 4
+    attach_configuration(particles, 'resolution')
+    assert particles[0]['config'] == [4, 1]
+    assert particles[0]['mass'] == 2
+
+
+@pytest.mark.parametrize('arch', ['numpy', 'cpu', 'cuda'])
+def test_equal_mass_does_not_mean_equal_identity(arch):
+    pool = Pool([{'config': [0, 15]}, {'config': [15, 0]}, {'config': [0, 15]}])
+    assert pool.base_mass.tolist() == [2, 2, 2]
+    pos = np.ones((3, 3), dtype=np.float64)
+    if arch == 'numpy':
+        engine = Oracle(pool, 4, 4., 1, 0., False, False, True)
+        assert engine.condense(engine.residents(pos)) == 1
+    else:
+        import taichi as ti
+        engine = make_kernel(pool, 4, 4., 1, 0., False, False, True, arch)
+        if arch == 'cuda':
+            assert ti.lang.impl.current_cfg().arch == ti.cuda
+        engine.pos.from_numpy(pos)
+        assert engine.tick() == 1
+        engine.sync_pool()
+    assert pool.alive.tolist() == [True, True, False]
+    assert pool.parent.tolist() == [0, 1, 0]
+    assert pool.count.tolist() == [2, 1, 1]
+    assert int((pool.base_mass[pool.alive] * pool.count[pool.alive]).sum()) == 6
