{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcp:study-snapshot:1",
  "title": "HCP static study capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "capture", "frame", "bindings", "particles", "source"],
  "properties": {
    "schema": {"const": "hcp-study-snapshot"},
    "version": {"const": 1},
    "numerics": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "storage_bits", "body_fraction_bits", "field_fraction_bits"],
      "properties": {
        "profile": {"enum": ["legacy_f32", "trial_f64"]},
        "storage_bits": {"enum": [32, 64]},
        "body_fraction_bits": {"type": "integer", "minimum": 0, "maximum": 52},
        "field_fraction_bits": {"type": "integer", "minimum": 0, "maximum": 52}
      },
      "oneOf": [
        {"properties": {"profile": {"const": "legacy_f32"}, "storage_bits": {"const": 32}, "body_fraction_bits": {"const": 23}, "field_fraction_bits": {"const": 23}}},
        {"properties": {"profile": {"const": "trial_f64"}, "storage_bits": {"const": 64}}}
      ]
    },
    "response_trace": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "generation", "tick", "frame", "work_limit", "work_required", "work_used", "readback_bytes", "capacity", "count", "packets", "rows"],
      "properties": {
        "status": {"enum": ["ok", "budget_refused", "unavailable"]},
        "generation": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "tick": {"$ref": "#/$defs/decimal"}, "frame": {"$ref": "#/$defs/point"},
        "work_limit": {"$ref": "#/$defs/decimal"}, "work_required": {"$ref": "#/$defs/decimal"},
        "work_used": {"$ref": "#/$defs/decimal"}, "readback_bytes": {"$ref": "#/$defs/decimal"},
        "capacity": {"$ref": "#/$defs/decimal"}, "count": {"$ref": "#/$defs/decimal"},
        "packets": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["slot", "comparison"],
          "properties": {"slot": {"type": "integer", "minimum": 0}, "comparison": {"$ref": "#/$defs/decimal"}}
        }},
        "rows": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["body", "child", "parent", "kind", "numerator", "denominator", "delta", "recipient", "body_mass", "source_mass", "production_eligible", "extraction_valid"],
          "properties": {
            "body": {"$ref": "#/$defs/nativeRecord"},
            "child": {"type": "integer", "minimum": 0}, "parent": {"type": "integer", "minimum": 0},
            "kind": {"enum": ["local", "inherited", "scoped_inherited"]},
            "numerator": {"$ref": "#/$defs/decimal"}, "denominator": {"$ref": "#/$defs/decimal"},
            "delta": {"$ref": "#/$defs/extractedPoint"}, "recipient": {"$ref": "#/$defs/extractedPoint"},
            "body_mass": {"type": ["number", "null"]}, "source_mass": {"type": ["number", "null"]},
            "production_eligible": {"type": "boolean"}, "extraction_valid": {"type": "boolean"}
          }
        }}
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "gravity", "generation", "tick", "frame", "work_limit", "work_required", "work_used", "readback_bytes", "rows"],
      "properties": {
        "status": {"enum": ["ok", "budget_refused", "unavailable"]},
        "gravity": {"type": "number", "minimum": 0},
        "generation": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]}, "tick": {"$ref": "#/$defs/decimal"},
        "frame": {"$ref": "#/$defs/point"},
        "work_limit": {"$ref": "#/$defs/decimal"}, "work_required": {"$ref": "#/$defs/decimal"},
        "work_used": {"$ref": "#/$defs/decimal"}, "readback_bytes": {"$ref": "#/$defs/decimal"},
        "rows": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["slot", "status", "relative", "position"],
          "properties": {
            "slot": {"type": "integer", "minimum": 0}, "status": {"type": "integer", "minimum": 0, "maximum": 3},
            "relative": {"anyOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]},
            "position": {"anyOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]}
          }
        }}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "study", "generation", "tick", "phase", "label"],
      "properties": {
        "session": {"$ref": "#/$defs/uuid"},
        "study": {"$ref": "#/$defs/uuid"},
        "generation": {"$ref": "#/$defs/uuid"},
        "tick": {"$ref": "#/$defs/decimal"},
        "phase": {"enum": ["published_seeded", "post_tick"]},
        "label": {"type": "string"}
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinates", "units", "reference", "camera_target", "target_kind", "focal_fields"],
      "properties": {
        "coordinates": {"const": "reference_local"},
        "units": {"const": "operative_model_units"},
        "reference": {"$ref": "#/$defs/point"},
        "camera_target": {"$ref": "#/$defs/point"},
        "target_kind": {"enum": ["legacy_origin", "captured_focal_centroid"]},
        "focal_fields": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "value", "position", "mass"],
            "properties": {
              "kind": {"enum": ["sibling_definition", "parent_value", "membership"]},
              "value": {"type": "string", "minLength": 1},
              "position": {"$ref": "#/$defs/point"},
              "mass": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "parent", "role", "units", "level"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "parent": {"type": "integer", "minimum": -1},
          "role": {"enum": ["root", "primary_step", "secondary_compression", "naming_equivalent"]},
          "units": {"type": "number", "exclusiveMinimum": 0},
          "level": {"type": "integer", "minimum": 0}
        }
      }
    },
    "particles": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "definition", "slot", "position", "radius", "mass", "exact_mass", "binding", "level", "exposure", "aggregate", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "slot": {"type": "integer", "minimum": 0},
          "position": {"$ref": "#/$defs/point"},
          "radius": {"type": ["number", "null"], "minimum": 0},
          "mass": {"type": ["number", "null"], "minimum": 0},
          "exact_mass": {"$ref": "#/$defs/decimal"},
          "binding": {"type": "integer", "minimum": 0},
          "level": {"type": "integer", "minimum": 0},
          "exposure": {"enum": ["aggregate", "parts", "standalone"]},
          "aggregate": {"type": "string", "minLength": 1},
          "label": {"type": "string"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "mode",
        "completed_tick",
        "prepared_generation",
        "body_records",
        "comparisons"
      ],
      "properties": {
        "backend": {
          "enum": [
            "native_cpu",
            "native_cuda"
          ]
        },
        "mode": {
          "enum": [
            "flat",
            "installed_hierarchy"
          ]
        },
        "completed_tick": {
          "$ref": "#/$defs/decimal"
        },
        "prepared_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeRecord"
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "comparison",
              "field",
              "level",
              "calculation_bits",
              "storage_bits",
              "fraction_bits"
            ],
            "properties": {
              "comparison": {
                "$ref": "#/$defs/decimal"
              },
              "field": {
                "$ref": "#/$defs/nativeRecord"
              },
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "calculation_bits": {
                "const": 64
              },
              "storage_bits": {
                "const": 64
              },
              "fraction_bits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 52
              }
            }
          }
        }
      }
    },
    "source": {"type": "object"}
  },
  "$defs": {
    "extractedPoint": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 3, "maxItems": 3},
    "nativeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "incarnation",
        "address",
        "record"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/decimal"
        },
        "incarnation": {
          "$ref": "#/$defs/decimal"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "record": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"const": "00000000-0000-0000-0000-000000000000"}},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}
