cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED STUDY)
  message(FATAL_ERROR "Pass the live study executable")
endif()
set(commands "${CMAKE_CURRENT_BINARY_DIR}/malformed-live.commands")
file(WRITE "${commands}" "add banana\nadd 20 nope\nremove -1\ntick NaN\ntick 1\nquit")
execute_process(COMMAND "${STUDY}" --commands "${commands}"
  OUTPUT_VARIABLE trace ERROR_VARIABLE diagnostics RESULT_VARIABLE result TIMEOUT 240)
file(REMOVE "${commands}")
if(NOT result STREQUAL "1")
  message(FATAL_ERROR "Expected the scripted refusal exit, got ${result}\n${diagnostics}")
endif()
string(REGEX MATCHALL "[^\n]+" lines "${trace}")
list(LENGTH lines count)
if(NOT count EQUAL 6)
  message(FATAL_ERROR "Expected create, four refusals and a successful tick\n${diagnostics}")
endif()
list(GET lines 0 initial)
string(JSON study GET "${initial}" observation capture study)
string(JSON generation GET "${initial}" generation)
string(JSON claims GET "${initial}" live_occurrences)
foreach(index RANGE 1 4)
  list(GET lines ${index} rejected)
  string(JSON status GET "${rejected}" status)
  string(JSON tick GET "${rejected}" completed_tick)
  string(JSON current_study GET "${rejected}" observation capture study)
  string(JSON current_generation GET "${rejected}" generation)
  string(JSON current_claims GET "${rejected}" live_occurrences)
  if(NOT status STREQUAL "invalid_input" OR NOT tick EQUAL 0 OR
     NOT current_study STREQUAL study OR NOT current_generation STREQUAL generation OR
     NOT current_claims STREQUAL claims)
    message(FATAL_ERROR "Numeric refusal ${index} changed the completed study")
  endif()
endforeach()
list(GET lines 5 final)
string(JSON command GET "${final}" command)
string(JSON status GET "${final}" status)
string(JSON tick GET "${final}" completed_tick)
string(JSON current_study GET "${final}" observation capture study)
if(NOT command STREQUAL "tick" OR NOT status STREQUAL "ok" OR
   NOT tick EQUAL 1 OR NOT current_study STREQUAL study)
  message(FATAL_ERROR "The original study did not tick after the refusals")
endif()
message(STATUS "Malformed numeric commands preserve the study, generation and claims before the next tick")
