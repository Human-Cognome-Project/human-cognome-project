cmake_minimum_required(VERSION 3.20)

file(READ "${COMMANDS}" commands)
string(REPLACE "lod parts\n" "lod parts\nadd 20\nremove 2\n" commands "${commands}")
set(command_file "${CMAKE_CURRENT_BINARY_DIR}/unicode-i-${HOST_PATH}.commands")
set(capture_file "${CMAKE_CURRENT_BINARY_DIR}/unicode-i-${HOST_PATH}.jsonl")
file(WRITE "${command_file}" "${commands}")
set(args --threads 1)
if(HOST_PATH STREQUAL "direct")
  set(args --threads 2 --direct)
endif()
execute_process(
  COMMAND "${STUDY}" ${args} --unicode-i --response-work-limit 1000000 --commands "${command_file}"
  RESULT_VARIABLE result OUTPUT_VARIABLE capture ERROR_VARIABLE error)
file(WRITE "${capture_file}" "${capture}")
if(NOT result STREQUAL "1")
  message(FATAL_ERROR "Expected both presence refusals and exit 1. Exit ${result}. ${error}")
endif()

function(expect record expected)
  string(JSON actual GET "${record}" ${ARGN})
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Record ${i} ${ARGN} is ${actual}, expected ${expected}. See ${capture_file}")
  endif()
endfunction()

string(STRIP "${capture}" capture)
string(REPLACE "\n" ";" records "${capture}")
list(LENGTH records count)
if(NOT count EQUAL 10)
  message(FATAL_ERROR "Expected ten completed records, found ${count}. ${error}. See ${capture_file}")
endif()
list(GET records 0 initial)
string(JSON study GET "${initial}" observation capture study)
string(JSON session GET "${initial}" observation capture session)
string(JSON logical_generation GET "${initial}" observation capture generation)
string(JSON root_claim GET "${initial}" observation execution comparisons 1 field)
expect("${initial}" "${HOST_PATH}" host_path)
expect("${initial}" 4 exact_source_mass_per_occurrence)
expect("${initial}" 3 capacities particles)

set(commands create observe lod add remove tick observe lod tick observe)
set(ticks 0 0 0 0 0 3 3 3 5 5)
foreach(i RANGE 0 9)
  list(GET records ${i} record)
  list(GET commands ${i} command)
  list(GET ticks ${i} tick)
  set(status ok)
  if(i EQUAL 3 OR i EQUAL 4)
    set(status unsupported)
    expect("${record}" OFF native_claims sampled)
    expect("${record}" "${expanded_particles}" observation particles)
    expect("${record}" "${expanded_claims}" live_occurrences)
    expect("${record}" "${previous_generation}" generation)
  endif()
  expect("${record}" "${command}" command)
  expect("${record}" "${status}" status)
  expect("${record}" "${tick}" completed_tick)
  expect("${record}" "${tick}" observation execution completed_tick)
  expect("${record}" native_cpu observation execution backend)
  expect("${record}" live-unicode-exchange observation source profile)
  expect("${record}" "${study}" observation capture study)
  expect("${record}" "${session}" observation capture session)
  expect("${record}" "${logical_generation}" observation capture generation)
  expect("${record}" ok observation response_trace status)
  string(JSON generation GET "${record}" generation)
  expect("${record}" "${generation}" observation response_trace generation)
  expect("${record}" "${tick}" observation response_trace tick)
  string(JSON count LENGTH "${record}" observation particles)
  if(i GREATER_EQUAL 2 AND i LESS 7)
    set(exposure parts)
    set(ids "${study}/2/0/0" "${study}/2/0/1")
    set(labels C3 AD)
    set(mass 2)
    set(root_index 6)
    set(expected_count 2)
  else()
    set(exposure aggregate)
    set(ids "${study}/2")
    set(labels í)
    set(mass 4)
    set(root_index 1)
    set(expected_count 1)
  endif()
  if(NOT count EQUAL expected_count)
    message(FATAL_ERROR "Wrong live cohort size in record ${i}. See ${capture_file}")
  endif()
  expect("${record}" "${exposure}" exposure)
  expect("${record}" 106 observation execution comparisons ${root_index} comparison)
  expect("${record}" "${root_claim}" observation execution comparisons ${root_index} field)
  math(EXPR last "${count} - 1")
  foreach(body RANGE 0 ${last})
    list(GET ids ${body} id)
    list(GET labels ${body} label)
    expect("${record}" "${id}" observation particles ${body} id)
    expect("${record}" "${label}" observation particles ${body} label)
    expect("${record}" "${mass}" observation particles ${body} exact_mass)
    string(JSON physical GET "${record}" observation particles ${body} mass)
    if(NOT physical EQUAL mass)
      message(FATAL_ERROR "Wrong physical mass in record ${i}. See ${capture_file}")
    endif()
  endforeach()
  if(command STREQUAL "lod")
    expect("${record}" "${exposure}" requested_exposure)
    expect("${record}" ON native_claims sampled)
    expect("${record}" 3 native_claims particles peak)
    expect("${record}" "${count}" native_claims particles after)
    expect("${record}" 8 native_claims fields peak)
    math(EXPR next_generation "${previous_generation} + 1")
    expect("${record}" "${next_generation}" generation)
  endif()
  if(i EQUAL 2)
    string(JSON expanded_particles GET "${record}" observation particles)
    string(JSON expanded_claims GET "${record}" live_occurrences)
  endif()
  set(previous_generation "${generation}")
endforeach()
message(STATUS "Unicode CLI ${HOST_PATH} round trip, chosen ticks and healthy presence refusals passed")
