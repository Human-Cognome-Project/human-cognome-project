# Exercise the combined CLI on the existing two-worker direct qualification run.
execute_process(
  COMMAND "${STUDY}" --threads 2 --direct --whole-field --response-work-limit 1000000 --commands "${COMMANDS}"
  OUTPUT_VARIABLE capture COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" records "${capture}")
set(exchanges 0)
foreach(record IN LISTS records)
  if(record STREQUAL "")
    continue()
  endif()
  string(JSON command GET "${record}" command)
  if(NOT command STREQUAL "lod")
    continue()
  endif()
  string(JSON status GET "${record}" status)
  string(JSON trace GET "${record}" observation response_trace)
  string(JSON traced GET "${trace}" status)
  string(JSON generation GET "${record}" generation)
  string(JSON trace_generation GET "${trace}" generation)
  string(JSON tick GET "${record}" completed_tick)
  string(JSON trace_tick GET "${trace}" tick)
  string(JSON rows LENGTH "${trace}" rows)
  if(NOT status STREQUAL "ok" OR NOT traced STREQUAL "ok" OR rows LESS 1 OR
     NOT generation STREQUAL trace_generation OR NOT tick STREQUAL trace_tick)
    message(FATAL_ERROR "Incomplete response capture for LoD exchange at tick ${tick}, generation ${generation}")
  endif()
  math(EXPR exchanges "${exchanges} + 1")
endforeach()
if(NOT exchanges EQUAL 4)
  message(FATAL_ERROR "Expected four completed exchanges, observed ${exchanges}")
endif()
