# Python / local environments
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Native build trees / generated objects
**/build/
engine/build*/
engine/taichi/build*/
engine/taichi/.venv/
*.o
*.obj

# Data downloads (fetched by sources/fetch.sh)
sources/data/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude / MCP
.claude/
.mcp.json

# Local infrastructure notes
infra/
resources/

# Discord relay (infrastructure, not core project)
relay/

# Entity catalogs (working files — real data is in entity DBs)
archive/2026-08-rebase/docs/research/*-entities.md

# Benchmark output (local, per-machine)
benchmarks/

# Reproducibility DB dumps: raw expansions of compressed/LFS snapshots
data/postgres/snapshots/*.sql

# LMDB runtime files
data/vocab.lmdb/

# Debug artifacts
archive/2026-08-rebase/hcp-engine/backtrace.log

# Research PDFs (large binaries; store externally)
archive/2026-08-rebase/docs/research/*.pdf
